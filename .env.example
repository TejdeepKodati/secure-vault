# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Secrets ---
# Signing key for session tokens. REQUIRED in production - the server refuses
# to start without it when NODE_ENV=production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Storage ---
# Root for all persistent state: user.json, files/, trash/.
# On a hosted platform this MUST point at a persistent volume, otherwise the
# vault and the user record are wiped on every restart or redeploy (SRS 27).
DATA_DIR=./data

# --- First-time initialisation only (SRS 5) ---
# Used ONLY when no user record exists yet. If left blank, a random PIN is
# generated and printed to the server log once, on first boot.
# A restart never recreates or resets this PIN.
INITIAL_PIN=

# --- Sessions ---
SESSION_TTL_SECONDS=43200
# Send the session cookie only over HTTPS. Defaults to true when
# NODE_ENV=production. Set to false if you terminate TLS elsewhere and cannot
# forward X-Forwarded-Proto.
COOKIE_SECURE=

# --- Upload limits ---
MAX_UPLOAD_BYTES=1073741824
MAX_FILES_PER_REQUEST=500

# --- Login throttling ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=300

# Failures across ALL addresses before everyone is paused (blunts distributed guessing).
LOGIN_GLOBAL_MAX_ATTEMPTS=50

# --- Reverse proxy ---
# Leave false unless a proxy YOU control sits in front and appends the client's
# address to X-Forwarded-For (nginx, Caddy, most cloud load balancers).
# With false, every request is attributed to the address that connected to this
# process - behind a proxy that means one shared bucket, which for a
# single-user vault is a safe (if blunt) throttle.
# With true, the address that many entries from the RIGHT of X-Forwarded-For is
# used (TRUST_PROXY_HOPS = number of trusted proxies in the chain). The left end
# is client-controlled and is never used.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# --- Recovery ---
# If user.json is missing but the vault already holds files, the server refuses
# to start rather than silently issuing a new PIN (usually a sign DATA_DIR is not
# on persistent storage). If you are certain you lost the PIN and want a new one,
# start ONCE with ALLOW_REINIT=true (optionally with INITIAL_PIN=...), sign in,
# then remove the variable. Your files are not touched.
# ALLOW_REINIT=true

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
